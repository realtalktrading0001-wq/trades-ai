# Server port
PORT=4000

# Telegram bot token (leave blank in dev to accept a mock user)
BOT_TOKEN=

# Bot username used to build invite links: https://t.me/<BOT_USERNAME>?startapp=ref_xxxxxx
BOT_USERNAME=tradesaipocketbot

# Your personal PocketOption affiliate/referral link
POCKETOPTION_REF_URL=https://pocketoption.com/?ref=YOUR_REF_CODE

# Telegram support handle (without @)
SUPPORT_HANDLE=Tradesaisupport

# Weekly prize pool (USD) shown on the Referrals screen
WEEKLY_PRIZE_POOL=400

# PocketOption affiliate ("Partners") API — real ID verification.
# hash = md5(`${user_id}:${PARTNER_ID}:${API_TOKEN}`)
# GET {API_BASE}/{user_id}/{PARTNER_ID}/{hash}
POCKETOPTION_API_TOKEN=
POCKETOPTION_PARTNER_ID=
POCKETOPTION_API_BASE=https://pocketpartners.com/api/user-info
MIN_DEPOSIT_USD=15

# Fallback only: when POCKETOPTION_API_TOKEN is blank, a submitted ID is
# auto-approved after this many seconds (simulated verification for local dev).
VERIFY_DELAY_SECONDS=6

# PocketOption S2S postback — real-time registration/FTD events (same pattern as
# the Manav/Maxx Telegram trackers: a real conversion pings us, we replay it to
# Meta CAPI). Additive to the polling-based verify flow above; never grants access.
# Set this to a long random string, then in the PocketOption Partners dashboard's
# postback/tracking settings, configure a postback URL pointing here with our
# sub_id macro echoed back (our affiliate link is tagged sub_id=<telegram_id>):
#   https://<your-host>/api/pocketoption/postback/registration?secret=<this>&sub_id={click_id}
#   https://<your-host>/api/pocketoption/postback/ftd?secret=<this>&sub_id={click_id}&sum={sum}
# (If PocketOption only offers ONE postback URL for all goals instead of one per
# goal, drop the /registration or /ftd path segment and add &event={event} instead.)
POCKETOPTION_POSTBACK_SECRET=

# Meta Conversions API — replay real PocketOption registrations/deposits back to
# Meta (matched via fbc/fbp a landing page captured). Each landing funnel reports to
# its OWN pixel/dataset, chosen by the attribution source stored with the click
# (hero | proof | free | app). Per funnel set <PREFIX>_PIXEL_ID and <PREFIX>_META_CAPI_TOKEN.
# A funnel's token falls back to the shared META_CAPI_TOKEN if its own isn't set.
# Leave a pixel blank to disable that funnel (its CAPI calls no-op — no cross-pixel pollution).

# Shared/fallback token — used by any funnel that has no <PREFIX>_META_CAPI_TOKEN of its own.
# (Handy if you have one System-User token with access to every pixel.)
META_CAPI_TOKEN=
# Optional: while testing, paste the Events Manager "Test Events" code to see server
# events arrive live across all funnels; remove it for production traffic.
META_CAPI_TEST_CODE=

# Hero funnel (landing/hero.html)
HERO_PIXEL_ID=
HERO_META_CAPI_TOKEN=
HERO_LANDING_URL=https://tradesaipocketbot.live/hero.html

# Proof funnel (landing/proof.html)
PROOF_PIXEL_ID=
PROOF_META_CAPI_TOKEN=
PROOF_LANDING_URL=https://tradesaipocketbot.live/proof.html

# Free funnel (landing/free.html)
FREE_PIXEL_ID=
FREE_META_CAPI_TOKEN=
FREE_LANDING_URL=https://tradesaipocketbot.live/free.html

# App funnel (landing/app.html)
APP_PIXEL_ID=
APP_META_CAPI_TOKEN=
APP_LANDING_URL=https://tradesaipocketbot.live/app.html
