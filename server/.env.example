# Server port
PORT=4000

# Telegram bot token (leave blank in dev to accept a mock user)
BOT_TOKEN=

# Bot username used to build invite links: https://t.me/<BOT_USERNAME>?startapp=ref_xxxxxx
BOT_USERNAME=tradesaipocketbot

# Your personal PocketOption affiliate/referral link
POCKETOPTION_REF_URL=https://pocketoption.com/?ref=YOUR_REF_CODE

# Telegram support handle (without @)
SUPPORT_HANDLE=Tradesaisupport

# Weekly prize pool (USD) shown on the Referrals screen
WEEKLY_PRIZE_POOL=400

# PocketOption affiliate ("Partners") API — real ID verification.
# hash = md5(`${user_id}:${PARTNER_ID}:${API_TOKEN}`)
# GET {API_BASE}/{user_id}/{PARTNER_ID}/{hash}
POCKETOPTION_API_TOKEN=
POCKETOPTION_PARTNER_ID=
POCKETOPTION_API_BASE=https://pocketpartners.com/api/user-info
MIN_DEPOSIT_USD=15

# Fallback only: when POCKETOPTION_API_TOKEN is blank, a submitted ID is
# auto-approved after this many seconds (simulated verification for local dev).
VERIFY_DELAY_SECONDS=6

# Meta Conversions API — used ONLY for the "Free" landing-page funnel, to replay
# real PocketOption registrations/deposits back to Meta (matched via fbc/fbp the
# Free page captured). Leave blank to disable (CAPI calls become no-ops).
FREE_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: while testing, paste the Events Manager "Test Events" code to see
# server events arrive live; remove it for production traffic.
META_CAPI_TEST_CODE=
# The public URL of the Free landing page (sent as event_source_url).
FREE_LANDING_URL=https://your-domain.com/free.html

# One-time welcome DM sent to a user the first time they allow the bot to message
# them (the Mini App's "Allow" popup). Edit freely; use \n for line breaks, HTML ok.
# Leave blank to use the built-in default.
WELCOME_MESSAGE=

# --- Admin broadcast tool (operated from inside Telegram via the bot) ----------
# Comma-separated Telegram numeric user IDs allowed to broadcast. DM the bot
# /broadcast with a wrong passphrase and it replies with your ID to put here.
ADMIN_CHAT_IDS=
# Secret passphrase required alongside an allow-listed ID: /broadcast <passphrase>
BROADCAST_PASSPHRASE=
# Secret for the Telegram webhook (path segment + secret_token header must match).
# Use a long random string, e.g. `openssl rand -hex 24`.
BOT_WEBHOOK_SECRET=
# Public base URL the bot webhook is registered against. On Render, RENDER_EXTERNAL_URL
# is set automatically; set this only to override (e.g. local tunnel for testing).
WEBHOOK_BASE_URL=
