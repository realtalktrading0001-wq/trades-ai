# Server port (dev default 4001 so it can run alongside the mini app on 4000)
PORT=4001

# Public website URL — used to build referral invite links (https://WEB_URL/?ref=xxxx)
WEB_URL=https://pocketaitrades.com

# --- Email login (Resend) ---------------------------------------------------
# Leave RESEND_API_KEY blank in dev: login codes are printed to the server
# console (and shown on the login screen) so you can sign in without email.
# In production, verify your domain at https://resend.com then set these:
RESEND_API_KEY=
EMAIL_FROM=TRADES AI <login@pocketaitrades.com>
APP_NAME=TRADES AI

# Support handle (without @)
SUPPORT_HANDLE=Tradesaisupport

# Daily referral prize pool (USD) shown on the Referrals screen
DAILY_PRIZE_POOL=1000

# --- PocketOption affiliate ("Partners") API — real ID verification ---------
# hash = md5(`${user_id}:${PARTNER_ID}:${API_TOKEN}`)
# GET {API_BASE}/{user_id}/{PARTNER_ID}/{hash}
POCKETOPTION_REF_URL=https://pocketoption.com/?ref=YOUR_REF_CODE
POCKETOPTION_API_TOKEN=
POCKETOPTION_PARTNER_ID=
POCKETOPTION_API_BASE=https://pocketpartners.com/api/user-info
MIN_DEPOSIT_USD=15

# Live-balance access gate: unlock signals when balance >= ACCESS_MIN_BALANCE_USD,
# and revoke access once a verified user's balance falls below REVOKE_BALANCE_USD.
ACCESS_MIN_BALANCE_USD=15
REVOKE_BALANCE_USD=5

# Fallback only: when POCKETOPTION_API_TOKEN is blank, a submitted ID is
# auto-approved after this many seconds (simulated verification for local dev).
VERIFY_DELAY_SECONDS=6
